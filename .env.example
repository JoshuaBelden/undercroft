# Copy to .env and adjust as needed.

# Game server
GAME_SERVER_PORT=8787
# Only accept WebSockets on this path (production sets /ws); unset for any path
# GAME_SERVER_PATH=/ws
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=undercroft
# Accept admin commands from clients (dev only)
DEV_MODE=true

# Client (exposed to the browser)
PUBLIC_GAME_SERVER_URL=ws://localhost:8787
PUBLIC_DEV_MODE=true

# Site only: password-reset emails and Discord sign-in (docs/dev/accounts.md).
# Without RESEND_API_KEY the reset link is printed in the `pnpm dev` console instead.
# RESEND_API_KEY=
# MAIL_FROM=Undercroft <noreply@undercroft.us>
# Discord application (redirect URI http://localhost:5173/auth/discord/callback). Empty hides it.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
