{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"lib": ["es2023", "dom", "dom.iterable"]
	}
}
