# Production reverse proxy (see docs/dev/deployment.md). Caddy gets and renews the TLS
# certificate for {$DOMAIN} by itself.
{$DOMAIN} {
	encode zstd gzip

	# The game server's WebSocket.
	handle /ws {
		reverse_proxy game:8787
	}

	# Built assets have content-hashed names (static/assets, see docs/dev/asset-pipeline.md):
	# a file never changes under its URL, so browsers keep it for a year without asking again.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy web:3000
	}
}
