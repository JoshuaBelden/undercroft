# Production reverse proxy (see docs/dev/deployment.md). Caddy gets and renews the TLS
# certificate for {$DOMAIN} by itself.
{$DOMAIN} {
	encode zstd gzip

	# The game server's WebSocket.
	handle /ws {
		reverse_proxy game:8787
	}

	# Built assets have content-hashed names (static/assets, see docs/dev/asset-pipeline.md):
	# a file never changes under its URL, so browsers keep it for a year without asking again.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy web:3000
	}
}

# The admin app (docs/dev/admin.md). Needs an `admin` DNS record (an A record to the droplet);
# without one, Caddy only logs that it can't get this certificate.
admin.{$DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy admin:3001
}

# www goes to the bare name, so sign-in cookies live on one origin. Needs a `www` DNS record (a
# CNAME to the domain); without one, Caddy only logs that it can't get this certificate.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
