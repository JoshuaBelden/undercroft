# Production settings, kept on the droplet as /opt/undercroft/.env (deploy/deploy.ts writes it on
# the first deploy). docker-compose.prod.yml fills in everything else. See docs/dev/deployment.md.

# The public hostname: TLS certificate, ORIGIN, and wss://<DOMAIN>/ws for the game server.
DOMAIN=play.example.com
MONGODB_DB=undercroft

# Password-reset emails (Resend). Without a key the reset link is only written to the web log.
RESEND_API_KEY=
# MAIL_FROM=Undercroft <noreply@play.example.com>

# Sign in with Discord. Leave empty to hide the button.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# "Continue with Steam" in the desktop app: a publisher Web API key from the Steamworks partner
# site, and the game's app id. Leave the key empty to hide it (docs/dev/desktop.md#steam-sign-in).
STEAM_WEB_API_KEY=
# STEAM_APP_ID=480

# Bug reports filed as GitHub issues: a fine-grained token with Issues read/write on this one
# repository only. Empty: reports are kept for the admin app, not filed.
GITHUB_TOKEN=
# GITHUB_REPO=JoshuaBelden/undercroft
