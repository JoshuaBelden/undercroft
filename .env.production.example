# Production settings, kept on the droplet as /opt/undercroft/.env (deploy/deploy.ts writes it on
# the first deploy). docker-compose.prod.yml fills in everything else. See docs/dev/deployment.md.

# The public hostname: TLS certificate, ORIGIN, and wss://<DOMAIN>/ws for the game server.
DOMAIN=play.example.com
MONGODB_DB=undercroft
