{
	"name": "undercroft",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
		"start:server": "tsx --env-file-if-exists=.env server/index.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"asset:dev": "tsx scripts/make-dev-asset.ts",
		"asset:build": "tsx scripts/build-assets.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/extensions": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"@types/three": "^0.187.0",
		"@types/ws": "^8.18.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"mongodb": "^7.8.0",
		"three": "^0.187.0",
		"ws": "^8.22.2"
	},
	"engines": {
		"node": ">=22.9"
	},
	"packageManager": "pnpm@10.28.0"
}
