{
	"name": "undercroft",
	"version": "0.2.0",
	"private": true,
	"description": "Co-op and solo first-person horror extraction game set in the catacombs.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host",
		"dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
		"dev:seed": "tsx --env-file-if-exists=.env scripts/seed-items.ts",
		"dev:admin": "pnpm -C admin dev",
		"admin:grant": "tsx --env-file-if-exists=.env scripts/admin-grant.ts",
		"start:server": "tsx --env-file-if-exists=.env server/index.ts",
		"build": "vite build",
		"build:admin": "pnpm -C admin build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && pnpm -C admin check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"release": "tsx scripts/release.ts",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"asset:dev": "tsx scripts/make-dev-asset.ts",
		"asset:build": "tsx scripts/build-assets.ts",
		"asset:audio": "tsx scripts/build-audio.ts",
		"asset:images": "tsx scripts/build-images.ts",
		"asset:levels": "tsx scripts/audio-levels.ts",
		"deploy:provision": "tsx deploy/provision.ts",
		"deploy:release": "tsx deploy/deploy.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/extensions": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"@types/three": "^0.187.0",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"ffmpeg-static": "5.2.0",
		"globals": "^17.6.0",
		"meshoptimizer": "^1.3.0",
		"mpg123-decoder": "^1.0.3",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"mongodb": "^7.8.0",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"three": "^0.187.0",
		"ws": "^8.22.2"
	},
	"engines": {
		"node": ">=22.9"
	},
	"packageManager": "pnpm@10.28.0"
}
