{
	"name": "undercroft-admin",
	"version": "0.1.0",
	"private": true,
	"description": "Undercroft's admin app: members, reports, ideas, feedback and game stats. See docs/dev/admin.md.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --port 5174 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5174",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"mongodb": "^7.8.0"
	}
}
